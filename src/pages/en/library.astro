---
// Tools
import type { Lang } from "@/i18n/defaultLangOptions";

// Layouts
import BaseLayout from "@/layouts/BaseLayout.astro";

// Compositions
import Center from "@/components/compositions/Center.astro";

// Components
import PageHero from "@/components/ui/PageHero.astro";
import LibrarySection from "@/components/library/LibrarySection.astro";
import Stack from "@/components/compositions/Stack.astro";

// Translations
const currentLocale = Astro.currentLocale as Lang;

const title = currentLocale === "ua" ? "Бібліотека" : "Library";
---

<BaseLayout seo={{ title }}>
  <Center
    maxWidth="87.5rem"
    space={{ default: "space-6", tablet: "space-7", laptop: "space-9" }}
  >
    <Stack space="space-10">
      <PageHero title={title} />
      <LibrarySection />
    </Stack>
  </Center>
</BaseLayout>
