---
// Components
import Heading from "../ui/Heading.astro";
import Section from "../ui/Section.astro";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<Section class="hero">
  <Heading
    tagName="h1"
    size="h3"
    class="font-heading color-secondary text-center"
  >
    {title}</Heading
  >
</Section>

<style>
  .hero {
    margin-block-start: calc(var(--space-11-fixed) + var(--header-height));
  }
</style>
