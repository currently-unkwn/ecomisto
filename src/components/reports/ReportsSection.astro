---
// Tools
import type { Lang } from "@/i18n/defaultLangOptions";
import { getCollection } from "astro:content";

// Compositions

// Components
import Section from "../ui/Section.astro";
import SingleReport from "./SingleReport.astro";
import Row from "../compositions/Row.astro";

// Data
const reports = await getCollection("reports");

const sortedReports = reports.sort((a, b) => b.data.year - a.data.year);
---

<Section class="reports">
  <Row
    rowGap={{ default: "space-8", tabletS: "space-0" }}
    columnGap={{ default: "space-0", tabletS: "space-8" }}
  >
    {sortedReports.map((report) => <SingleReport report={report} />)}
  </Row>
</Section>

<style>
  .reports {
    padding-block-end: var(--space-11-fixed);
  }
</style>
